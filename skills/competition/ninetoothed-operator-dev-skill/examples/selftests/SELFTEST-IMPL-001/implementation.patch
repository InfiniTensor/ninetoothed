+def make_pool2d_layout_sensitive_input(shape, dtype, device):
+    base = torch.arange(math.prod(shape), dtype=torch.int64, device=device).reshape(
+        shape
+    )
+    fine = (base.remainder(17).to(torch.float32) - 8.0) * 0.25
+    coarse = torch.floor(base.to(torch.float32) / 17.0) * 0.03125
+
+    return (fine + coarse).to(dtype=dtype)
+
+
 def _random_shape(ndim, min_num_elements=2**8, max_num_elements=2**10):
