diff --git a/tests/test_avg_pool2d.py b/tests/test_avg_pool2d.py
index fe36390..7e2ebaf 100644
--- a/tests/test_avg_pool2d.py
+++ b/tests/test_avg_pool2d.py
@@ -6,6 +6,20 @@ import ntops
 from tests.skippers import skip_if_cuda_not_available
 
 
+def _make_pool_input(n, c, h, w, dtype, device, non_contiguous):
+    storage_w = w * 2 if non_contiguous else w
+    values = torch.arange(
+        n * c * h * storage_w, dtype=torch.float32, device=device
+    ).reshape(n, c, h, storage_w)
+    values = values.remainder(29).sub(14).div(9)
+    values = values.to(dtype)
+
+    if non_contiguous:
+        values = values[..., ::2]
+
+    return values
+
+
