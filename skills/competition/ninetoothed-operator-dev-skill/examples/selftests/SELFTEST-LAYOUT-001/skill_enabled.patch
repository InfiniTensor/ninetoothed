+            "padding": (1, 1),
+            "non_contiguous": False,
+        },
+        {
+            "shape": (1, 1, 4, 7),
+            "kernel_size": (3, 3),
+            "stride": (1, 2),
+            "padding": (1, 0),
+            "non_contiguous": True,
+        },
+    ),
+    ids=("padded-strided-boundary", "non-contiguous-source-view"),
+)
+def test_avg_pool2d_layout_sensitive_cases(case, dtype, device, rtol, atol):
